+# Test pipeline bisection (BLAB_TEST_PIPE_SERIALIZE=solve,dense,gpu): each named pairing between
+# frequency i+1's first half and frequency i's later stages shares one lock, so it cannot overlap.
+#   solve: i+1's FEM condensation (MUMPS factorization) vs i's solve (MUMPS reduce/back substitution)
+#   dense: i+1's FEM condensation vs i's dense stage (block assembly, elimination, dense LU)
+#   gpu:   i+1's GPU operator assembly vs i's field evaluation
+const _TEST_PIPE_LOCKS = Dict(:solve => ReentrantLock(), :dense => ReentrantLock(), :gpu => ReentrantLock())
+const _TEST_PIPE_SECTION_GROUPS = Dict(:fem => (:solve, :dense), :solve => (:solve,), :dense => (:dense,), :gpu => (:gpu,))
+
+function _test_pipe_section(f, section::Symbol)
+    selected = split(get(ENV, "BLAB_TEST_PIPE_SERIALIZE", ""), ',')
+    groups = [g for g in _TEST_PIPE_SECTION_GROUPS[section] if String(g) in selected]
+    return _test_pipe_locked(f, groups)
+end
+
+function _test_pipe_locked(f, groups)
+    isempty(groups) && return f()
+    return lock(() -> _test_pipe_locked(f, groups[2:end]), _TEST_PIPE_LOCKS[groups[1]])
+end
