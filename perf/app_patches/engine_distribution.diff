+# Local experiment, not upstream: "BEAT Engine (Apple Metal test)" runs the Julia
+# sources of the sibling beat-engine-test checkout (coupled Metal prefetch). Its
+# requests are still marked "metal"; only the solver script and Julia project differ.
+METAL_TEST_BACKEND_ID = "beat_metal_test"
+METAL_TEST_LABEL = "BEAT Engine (Apple Metal test)"
+METAL_TEST_ROOT = Path(__file__).resolve().parents[4] / "beat-engine-test" / "src" / "beat_engine"
+METAL_TEST_PROJECT = METAL_TEST_ROOT / "julia_metal"
+METAL_TEST_SYSTEM_SOLVER = METAL_TEST_ROOT / "julia_local" / "coupled_solver.jl"
+METAL_TEST_SOURCE_SOLVER = METAL_TEST_ROOT / "julia_local" / "solver.jl"
+METAL_TEST_SOLVER_OPTIONS = {
+    "test_env": {
+        # 2026-09-26 (beat-engine-test perf/NOTES.md): tile-reduced far-field kernel, Apple
+        # Accelerate, fast field evaluation, fused dense-norm pass. Prefetch is off: with the
+        # faster kernel the GPU assembly hides behind the FEM condensation, and prefetch only
+        # adds CPU contention (1.31 vs 1.46 s/freq).
+        "BLAB_TEST_COUPLED_PREFETCH": "1",   # round 11: on again, for EARLY_BUILD (see below)
+        "BLAB_METAL_REGULAR_KERNEL_MODE": "pair_tilereduce",
+        "BLAB_TEST_BLAS": "accelerate",
+        "BLAB_METAL_FIELD_FAST": "3",
+        "BLAB_TEST_DENSE_STATS": "1",
+        # 2026-09-26 round 5: threaded Burton-Miller matrix build, bit-identical (bem_matrix 0.10 -> 0.04).
+        "BLAB_TEST_BM_THREADED": "1",
+        # 2026-09-26 round 6: GC off during each frequency, one collection after (-0.05 s/freq,
+        # bit-identical), and a blocked ComplexF32 LU with cgemm trailing updates (-0.085 s/freq,
+        # maxrel 1.3e-7). Harness: 1.224 -> 1.084 s/freq.
+        "BLAB_TEST_GC_DEFER": "1",
+        "BLAB_TEST_BLOCKED_LU": "512",
+        # 2026-09-26 round 7: blocked gemm-based F32 LU solve (-0.028 s/freq, maxrel 6.6e-8) and the
+        # previous frequency's F32 LU as a GMRES preconditioner at low frequencies (-0.031 s/freq on
+        # the 50-freq sweep, maxrel 1.8e-8; falls back to a fresh LU above ~1 kHz).
+        "BLAB_TEST_FAST_TRS": "128",
+        "BLAB_TEST_STALE_LU": "15",
+        # 2026-09-26 round 8, all bit-identical: pooled Metal operator buffers, symmetry row weights
+        # folded into the host Burton-Miller combine, and no S/K' work for faces without flux
+        # (50-freq sweep 0.972 -> 0.899 s/freq).
+        "BLAB_TEST_OP_POOL": "1",
+        "BLAB_TEST_HOST_ROW_WEIGHTS": "1",
+        "BLAB_TEST_FLUX_SKIP": "1",
+        # 2026-09-26 round 9 (ideas from the CUDA backend): symmetry images summed before the gathers,
+        # combined Burton-Miller assembly on the GPU (maxrel 5.8e-6), MUMPS expansion for the
+        # transducer solves, and the interface-mass solve on 4 tasks (50-freq 0.910 -> 0.823 s/freq).
+        "BLAB_TEST_IMAGE_ACCUMULATE": "1",
+        "BLAB_TEST_COMBINED_BM": "1",
+        "BLAB_TEST_MUMPS_EXPAND": "1",
+        "BLAB_TEST_MASS_THREADS": "4",
+        # 2026-09-26 round 10: the flux elimination's B_q*W product stays implicit in the Float64
+        # refinement residual; only the Float32 LU input gets it, from a cgemm (maxrel 1.1e-7). A host
+        # array pool reuses the big per-frequency arrays instead of page-faulting fresh memory
+        # (1.13 -> 0.37 GB/freq, bit-identical). 50-freq sweep 0.807 -> 0.667 s/freq.
+        "BLAB_TEST_ELIM_IMPLICIT": "1",
+        "BLAB_TEST_HOST_POOL": "1",
+        # 2026-09-26 round 11: MUMPS without numerical pivoting (CNTL(1)=0; the SAWMOD FEM matrix never
+        # delays a pivot, the search alone cost 0.04 s per factorization; a failed factorization
+        # retries with the default threshold). 50-freq 0.642 -> 0.623 s/freq, maxrel 4.4e-8.
+        "BLAB_TEST_MUMPS_CNTL": "1=0",
+        # Round 11: no Float32 FEM system assembled only to be replaced by the Float64 one (bit-identical,
+        # -0.006 s/freq).
+        "BLAB_TEST_FEM_F32_SKIP": "1",
+        # Round 11: frequency i+1's build (FEM stage, elimination, LU) starts right after frequency i's
+        # solve and overlaps its field; its GPU operators were prefetched during i's host stages, now
+        # with the round 8/9 GPU switches (PREFETCH_OPT; they were off for prefetch). Bit-identical.
+        # 50-freq 0.625 -> 0.571 s/freq.
+        "BLAB_TEST_EARLY_BUILD": "1",
+        "BLAB_TEST_PREFETCH_OPT": "1",
+        # Round 11: no MUMPS reduction of an all-zero FEM right-hand side (voltage-only excitations).
+        # Bit-identical, 0.574 -> 0.549 s/freq.
+        "BLAB_TEST_ZERO_RHS_SKIP": "1",
+    }
+}
+
+
+def metal_test_available() -> bool:
+    return METAL_TEST_SYSTEM_SOLVER.exists() and (METAL_TEST_PROJECT / "Manifest.toml").exists()
+
+
+def is_metal_test_backend(value: object) -> bool:
+    return str(value or "").strip().lower() in {"metal_test", METAL_TEST_BACKEND_ID}
+
+
 __all__ = ["backend_catalog", "engine_backend_info", "engine_paths"]
